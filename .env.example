# Teamwork API Configuration
# Get your API token: Teamwork > Profile > Edit My Details > API & Mobile > Show Your Token

# Your Teamwork API token (required)
TEAMWORK_API_TOKEN=your-api-token-here

# Your Teamwork site name - the subdomain from your Teamwork URL
# Example: For https://acmecorp.teamwork.com, use "acmecorp"
TEAMWORK_SITE_NAME=yourcompany

# Teamwork tasklist ID for creating new tasks (required for task creation)
# Find it: Open your project in Teamwork > Tasks > Click on a tasklist > Copy ID from URL
# Example: For https://yourcompany.teamwork.com/app/tasklists/12345678, use "12345678"
# If not set, script will only update existing tasks (skip PRDs without task IDs)
TEAMWORK_TASKLIST_ID=
