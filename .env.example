# Teamwork API Configuration
# Get your API token: Teamwork > Profile > Edit My Details > API & Mobile > Show Your Token

# Your Teamwork API token (required)
TEAMWORK_API_TOKEN=your-api-token-here

# Your Teamwork site name - the subdomain from your Teamwork URL
# Example: For https://acmecorp.teamwork.com, use "acmecorp"
TEAMWORK_SITE_NAME=yourcompany
